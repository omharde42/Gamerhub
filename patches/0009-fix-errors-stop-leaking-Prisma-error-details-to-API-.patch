From 50a908ee70b56b655a8a1d87ea25f876cba9c90e Mon Sep 17 00:00:00 2001
From: "omharde@4" <you@example.com>
Date: Thu, 13 Aug 2026 11:19:44 +0530
Subject: [PATCH 09/12] fix(errors): stop leaking Prisma error details to API
 clients
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The error handler returned err.message verbatim for Prisma
PrismaClientKnownRequestError (P2002/P2003/...) and the raw last line of
PrismaClientValidationError output, which can expose table/column names and
internal query details (information disclosure, low-medium).

Details are now logged server-side only; clients receive generic per-code
messages with the same HTTP status codes as before.

Validation: cd server && npx tsc --noEmit.

🤖 Generated with Codebuff
Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 server/src/middleware/errorHandler.ts | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/server/src/middleware/errorHandler.ts b/server/src/middleware/errorHandler.ts
index fa8a15f..d1a0f91 100644
--- a/server/src/middleware/errorHandler.ts
+++ b/server/src/middleware/errorHandler.ts
@@ -28,19 +28,27 @@ export const errorHandler = (err: Error, _req: Request, res: Response, _next: Ne
     return;
   }
   if (err instanceof Prisma.PrismaClientKnownRequestError) {
+    // Log details server-side but never return raw Prisma messages to clients:
+    // they can reveal table/column names and internal schema details.
+    console.error('Prisma error:', err.code, err.message);
     const statusMap: Record<string, number> = {
       P2002: 409,
       P2003: 400,
       P2023: 400,
       P2025: 404,
     };
-    res.status(statusMap[err.code] || 400).json({ success: false, message: err.message });
+    const messageMap: Record<string, string> = {
+      P2002: 'A record with these details already exists',
+      P2003: 'Invalid reference provided',
+      P2023: 'Invalid data provided',
+      P2025: 'Record not found',
+    };
+    res.status(statusMap[err.code] || 400).json({ success: false, message: messageMap[err.code] || 'Database operation failed' });
     return;
   }
   if (err instanceof Prisma.PrismaClientValidationError) {
     console.error('Prisma Validation Error:', err.message);
-    const lastLine = err.message.split('\n').filter(Boolean).pop() || 'Invalid database input';
-    res.status(400).json({ success: false, message: `Database validation error: ${lastLine}` });
+    res.status(400).json({ success: false, message: 'Invalid database input' });
     return;
   }
   console.error('Unhandled error:', err);
