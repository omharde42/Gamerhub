<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive auth tokens and cached data from adb backup -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="databases" />
    <exclude domain="root" path="shared_preferences" />
</full-backup-content>
